    "Pings %@ once a second. That host sees your public IP address.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pingt %@ einmal pro Sekunde. Dieser Host sieht deine öffentliche IP-Adresse."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pings %@ once a second. That host sees your public IP address."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hace ping a %@ una vez por segundo. Ese host ve tu dirección IP pública."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie un ping à %@ chaque seconde. Cet hôte voit votre adresse IP publique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fa il ping a %@ una volta al secondo. Quell’host vede il tuo indirizzo IP pubblico."
          }
        }
      }
    },
