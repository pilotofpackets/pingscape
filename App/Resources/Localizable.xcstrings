    "A VPN that carries all traffic is active. The local network is often not reachable then.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein VPN, das den gesamten Verkehr trägt, ist aktiv. Das lokale Netz ist dann oft nicht erreichbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A VPN that carries all traffic is active. The local network is often not reachable then."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una VPN activa que transporta todo el tráfico. Entonces la red local suele no estar accesible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un VPN qui transporte tout le trafic est actif. Le réseau local est alors souvent inaccessible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È attiva una VPN che instrada tutto il traffico. In questo caso la rete locale spesso non è raggiungibile."
          }
        }
      }
    },
