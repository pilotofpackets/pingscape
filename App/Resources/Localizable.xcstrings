            "value": "Dieses Gerät hat keine lokale IPv4-Adresse. Verbinde dich mit einem WLAN, um nach Geräten zu suchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device has no local IPv4 address. Connect to Wi-Fi to look for devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no tiene dirección IPv4 local. Conéctate a una red Wi-Fi para buscar dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil n’a pas d’adresse IPv4 locale. Connectez-vous à un réseau Wi-Fi pour rechercher des appareils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo non ha un indirizzo IPv4 locale. Connettiti a una rete Wi-Fi per cercare dispositivi."
          }
        }
      }
    },
