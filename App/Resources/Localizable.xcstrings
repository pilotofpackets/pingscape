    "Each server sees your public IP address, as with any request. Nothing else is sent: no device data, no location. There is no server of Pingscape.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Server sieht deine öffentliche IP-Adresse, wie bei jeder Anfrage. Sonst wird nichts gesendet: keine Gerätedaten, kein Standort. Einen Server von Pingscape gibt es nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each server sees your public IP address, as with any request. Nothing else is sent: no device data, no location. There is no server of Pingscape."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada servidor ve tu dirección IP pública, como en cualquier petición. No se envía nada más: ni datos del dispositivo ni ubicación. Pingscape no tiene servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque serveur voit votre adresse IP publique, comme pour toute requête. Rien d’autre n’est envoyé : ni données de l’appareil, ni position. Pingscape n’a pas de serveur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni server vede il tuo indirizzo IP pubblico, come per qualsiasi richiesta. Non viene inviato altro: né dati del dispositivo né la posizione. Pingscape non ha un proprio server."
          }
        }
      }
    },
    "Enter a MAC address or its first three bytes": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib eine MAC-Adresse oder ihre ersten drei Bytes ein"
