    "To find devices in your network, Pingscape asks them directly. iOS asks you once to allow this. The results stay on your iPhone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um Geräte in deinem Netz zu finden, fragt Pingscape sie direkt an. iOS fragt dich einmal, ob du das erlaubst. Die Ergebnisse bleiben auf deinem iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To find devices in your network, Pingscape asks them directly. iOS asks you once to allow this. The results stay on your iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para encontrar los dispositivos de tu red, Pingscape les pregunta directamente. iOS te pide una vez que lo permitas. Los resultados se quedan en tu iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour trouver les appareils de votre réseau, Pingscape les interroge directement. iOS vous demande une seule fois de l’autoriser. Les résultats restent sur votre iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per trovare i dispositivi della tua rete, Pingscape li interroga direttamente. iOS ti chiede una volta di consentirlo. I risultati restano sul tuo iPhone."
          }
        }
      }
    },
    "To find devices in your network, Pingscape asks them directly. The results stay on your iPhone. Allow it in Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um Geräte in deinem Netz zu finden, fragt Pingscape sie direkt an. Die Ergebnisse bleiben auf deinem iPhone. Erlaube das in den Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To find devices in your network, Pingscape asks them directly. The results stay on your iPhone. Allow it in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para encontrar los dispositivos de tu red, Pingscape les pregunta directamente. Los resultados se quedan en tu iPhone. Permítelo en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour trouver les appareils de votre réseau, Pingscape les interroge directement. Les résultats restent sur votre iPhone. Autorisez-le dans les Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per trovare i dispositivi della tua rete, Pingscape li interroga direttamente. I risultati restano sul tuo iPhone. Consentilo in Impostazioni."
          }
        }
      }
    },
