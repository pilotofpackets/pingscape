    "Everything runs on your device. Nothing is collected or sent anywhere.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles läuft auf deinem Gerät. Es wird nichts gesammelt oder irgendwohin gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything runs on your device. Nothing is collected or sent anywhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo se ejecuta en tu dispositivo. No se recopila ni se envía nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout s’exécute sur votre appareil. Rien n’est collecté ni envoyé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto viene eseguito sul tuo dispositivo. Non viene raccolto né inviato nulla."
          }
        }
      }
    },
    "Everything runs on your device. Requests to the internet happen only when you allow or start them, and only to the servers listed under Licenses and sources.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles läuft auf deinem Gerät. Anfragen ins Internet gibt es nur, wenn du sie erlaubst oder startest, und nur an die Server, die unter „Lizenzen und Quellen“ stehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything runs on your device. Requests to the internet happen only when you allow or start them, and only to the servers listed under Licenses and sources."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo se ejecuta en tu dispositivo. Las peticiones a internet solo se hacen cuando las permites o las inicias, y solo a los servidores indicados en Licencias y fuentes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout s’exécute sur votre appareil. Les requêtes vers Internet n’ont lieu que si vous les autorisez ou les lancez, et seulement vers les serveurs listés sous Licences et sources."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto viene eseguito sul tuo dispositivo. Le richieste a Internet avvengono solo quando le consenti o le avvii, e solo verso i server elencati in Licenze e fonti."
          }
        }
      }
    },
