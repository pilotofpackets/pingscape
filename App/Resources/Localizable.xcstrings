    "Also tries a few ports on addresses that do not answer a ping, and lists open ports.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Probiert zusätzlich einige Ports bei Adressen, die nicht auf Ping antworten, und listet offene Ports auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Also tries a few ports on addresses that do not answer a ping, and lists open ports."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También prueba algunos puertos en las direcciones que no responden al ping y muestra los puertos abiertos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Teste également quelques ports sur les adresses qui ne répondent pas au ping et liste les ports ouverts."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova anche alcune porte sugli indirizzi che non rispondono al ping ed elenca le porte aperte."
          }
        }
      }
    },
