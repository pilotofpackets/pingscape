    "Only needed to read the name of your Wi-Fi network. Pingscape does not use your location.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur nötig, um den Namen deines WLANs zu lesen. Pingscape nutzt deinen Standort nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only needed to read the name of your Wi-Fi network. Pingscape does not use your location."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo hace falta para leer el nombre de tu red Wi-Fi. Pingscape no usa tu ubicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessaire uniquement pour lire le nom de votre réseau Wi-Fi. Pingscape n’utilise pas votre position."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve solo per leggere il nome della tua rete Wi-Fi. Pingscape non usa la tua posizione."
          }
        }
      }
    },
    "Only scan devices that belong to you or that you have permission to scan. Outside your own network only the common ports are scanned.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne nur Geräte, die dir gehören oder für die du eine Erlaubnis hast. Außerhalb deines eigenen Netzes werden nur die häufigen Ports geprüft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only scan devices that belong to you or that you have permission to scan. Outside your own network only the common ports are scanned."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea solo dispositivos que te pertenezcan o que tengas permiso para escanear. Fuera de tu propia red solo se escanean los puertos comunes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne scannez que des appareils qui vous appartiennent ou que vous avez le droit de scanner. En dehors de votre propre réseau, seuls les ports courants sont scannés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansiona solo dispositivi di tua proprietà o che hai il permesso di scansionare. Al di fuori della tua rete vengono scansionate solo le porte comuni."
          }
        }
      }
    },
    "Only the handshake happens. No data is sent.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es findet nur der Handshake statt. Es werden keine Daten gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the handshake happens. No data is sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se realiza el handshake. No se envían datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seule la négociation (handshake) a lieu. Aucune donnée n’est envoyée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avviene solo l’handshake. Non vengono inviati dati."
          }
        }
      }
    },
    "Only when you tap “Check internet”": {
      "localizations": {
