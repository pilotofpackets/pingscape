          "stringUnit": {
            "state": "translated",
            "value": "Estado de la red"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "État du réseau"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stato della rete"
          }
        }
      }
    },
    "Reads the state of the network right now and returns it as text: connection, Wi-Fi, VPN and cellular. Nothing is changed or sent anywhere.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest den Zustand des Netzwerks jetzt und gibt ihn als Text zurück: Verbindung, WLAN, VPN und Mobilfunk. Es wird nichts geändert oder irgendwohin gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads the state of the network right now and returns it as text: connection, Wi-Fi, VPN and cellular. Nothing is changed or sent anywhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee el estado actual de la red y lo devuelve como texto: conexión, Wi-Fi, VPN y red móvil. No se cambia ni se envía nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit l’état du réseau à l’instant même et le renvoie sous forme de texte : connexion, Wi-Fi, VPN et réseau cellulaire. Rien n’est modifié ni envoyé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Legge lo stato attuale della rete e lo restituisce come testo: connessione, Wi-Fi, VPN e rete cellulare. Non viene modificato né inviato nulla."
          }
        }
      }
    },
