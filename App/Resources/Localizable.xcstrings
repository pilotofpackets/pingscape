    "External requests load your public IP address, its reverse DNS name and the provider (ipify, RIPEstat). They are off until you allow them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Externe Abfragen laden deine öffentliche IP-Adresse, deren Reverse-DNS-Namen und den Provider (ipify, RIPEstat). Sie sind aus, bis du sie erlaubst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "External requests load your public IP address, its reverse DNS name and the provider (ipify, RIPEstat). They are off until you allow them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las peticiones externas cargan tu dirección IP pública, su nombre DNS inverso y el proveedor (ipify, RIPEstat). Están desactivadas hasta que las permitas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les requêtes externes chargent votre adresse IP publique, son nom DNS inverse et le fournisseur (ipify, RIPEstat). Elles sont désactivées tant que vous ne les autorisez pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le richieste esterne caricano il tuo indirizzo IP pubblico, il suo nome DNS inverso e il provider (ipify, RIPEstat). Sono disattivate finché non le consenti."
          }
        }
      }
    },
    "Firmware": {
