    "The name goes to the registry that is responsible for it. Registry data of others is not hidden by “Hide values”.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Name geht an das Register, das dafür zuständig ist. Registerdaten anderer werden von „Werte verbergen“ nicht verborgen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The name goes to the registry that is responsible for it. Registry data of others is not hidden by “Hide values”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre se envía al registro responsable. Los datos de registro de terceros no se ocultan con «Ocultar valores»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom est envoyé au registre compétent. Les données de registre d’autres personnes ne sont pas masquées par « Masquer les valeurs »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nome viene inviato al registro competente. I dati di registro di terzi non vengono nascosti da «Nascondi i valori»."
          }
        }
      }
    },
