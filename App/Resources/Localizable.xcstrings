    "iOS only gives the name of your Wi-Fi network to apps that may use your location. Pingscape does not use your location.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS gibt den Namen deines WLANs nur an Apps weiter, die deinen Standort nutzen dürfen. Pingscape nutzt deinen Standort nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS only gives the name of your Wi-Fi network to apps that may use your location. Pingscape does not use your location."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS solo entrega el nombre de tu red Wi-Fi a las apps autorizadas a usar tu ubicación. Pingscape no usa tu ubicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ne transmet le nom de votre réseau Wi-Fi qu’aux apps autorisées à utiliser votre position. Pingscape n’utilise pas votre position."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS fornisce il nome della tua rete Wi-Fi solo alle app autorizzate a usare la tua posizione. Pingscape non usa la tua posizione."
          }
        }
      }
    },
