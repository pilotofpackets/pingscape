    "The round trip to a host or to the default gateway, from three pings. Tap ↻ to measure again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The round trip to a host or to the default gateway, from three pings. Tap ↻ to measure again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Antwortzeit eines Hosts oder des Standard-Gateways aus drei Pings. Tippe auf ↻, um neu zu messen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le temps aller-retour vers un hôte ou la passerelle par défaut, sur trois pings. Touchez ↻ pour mesurer à nouveau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tiempo de ida y vuelta a un host o a la puerta de enlace predeterminada, de tres pings. Toca ↻ para volver a medir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tempo di andata e ritorno verso un host o il gateway predefinito, da tre ping. Tocca ↻ per misurare di nuovo."
          }
        }
      }
    },
