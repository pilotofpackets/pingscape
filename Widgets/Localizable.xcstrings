    "Whether the device is online, over what, and whether a VPN is active. It shows the time it was read.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ob das Gerät online ist, worüber und ob ein VPN aktiv ist. Das Widget zeigt, wann es gelesen wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whether the device is online, over what, and whether a VPN is active. It shows the time it was read."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica si el dispositivo está en línea, a través de qué y si hay una VPN activa. El widget muestra cuándo se leyó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique si l’appareil est en ligne, via quoi, et si un VPN est actif. Le widget affiche l’heure de la lecture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica se il dispositivo è online, tramite cosa e se è attiva una VPN. Il widget mostra quando è stato letto."
          }
        }
      }
    },
