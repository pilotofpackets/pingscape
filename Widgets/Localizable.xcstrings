    "Choose the host. Without one, the widget pings the default gateway.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the host. Without one, the widget pings the default gateway."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle den Host. Ohne Host pingt das Widget das Standard-Gateway an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez l’hôte. Sans hôte, le widget envoie un ping à la passerelle par défaut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige el host. Sin host, el widget hace ping a la puerta de enlace predeterminada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli l’host. Senza host, il widget fa il ping al gateway predefinito."
          }
        }
      }
    },
